  "slides": [
    {
      "type": "content",
      "section": "なぜ作ったのか",
      "title": "予定は、いろいろな場所に散らばっていた。",
      "lead": "家族の予定を一つに把握できず、気づいたときには当日を迎えてしまう。",
      "figure": {
        "viewBox": [1180, 440],
        "shapes": [
          {"kind": "roundRect", "x": 20, "y": 30, "w": 360, "h": 160, "radius": 12,
           "fill": "pale", "line": "grayLine", "text": "LINEの連絡", "size": 18},
          {"kind": "roundRect", "x": 410, "y": 30, "w": 360, "h": 160, "radius": 12,
           "fill": "pale", "line": "grayLine", "text": "紙カレンダー", "size": 18},
          {"kind": "roundRect", "x": 800, "y": 30, "w": 360, "h": 160, "radius": 12,
